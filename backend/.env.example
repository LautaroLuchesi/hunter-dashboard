# Copiá este archivo como `.env` y completá los valores reales.
#   cp .env.example .env      (Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
#
# El archivo `.env` está ignorado por Git: NO se sube al repo.

# ID de la planilla de Google Sheets.
# Se saca de la URL: https://docs.google.com/spreadsheets/d/<ESTE_ES_EL_ID>/edit
SPREADSHEET_ID=

# Puerto del servidor. Si se omite, usa 3000.
PORT=3000
